{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Avocadots Design System — source of truth. Style-Dictionary shaped. Primitives hold raw values; semantic tokens alias them. Components reference semantic tokens only.",
  "color": {
    "green": {
      "$type": "color",
      "$description": "The brand ramp. green-400 is the existing Avocadots green; green-900 is the existing deep forest. They are the two ends of one ramp.",
      "50": {
        "$value": "#f2f8ea"
      },
      "100": {
        "$value": "#e2efd0"
      },
      "200": {
        "$value": "#c7e0a6"
      },
      "300": {
        "$value": "#a8ce76"
      },
      "400": {
        "$value": "#86bd42",
        "$description": "Brand green. FILL ONLY — 2.24:1 on white, never use as text on a light surface."
      },
      "500": {
        "$value": "#6ea233"
      },
      "600": {
        "$value": "#57822a",
        "$description": "Brand green for text and links on white — 4.53:1, AA."
      },
      "700": {
        "$value": "#436421"
      },
      "800": {
        "$value": "#334c1a"
      },
      "850": {
        "$value": "#24443a",
        "$description": "Raised surface on the forest-dark canvas."
      },
      "900": {
        "$value": "#1c3830",
        "$description": "Deep forest. Primary ink on light, primary surface on dark."
      },
      "950": {
        "$value": "#0f1f1a"
      }
    },
    "gold": {
      "$type": "color",
      "$description": "The second brand colour. On avocadots.com it carries the primary CTA, the nav CTA, whole section backgrounds and a highlighter on running copy — not a minor accent. gold-500 is a fill; white on it is 1.69:1 and must never be used.",
      "100": {
        "$value": "#fdf3d4"
      },
      "300": {
        "$value": "#f4dc7e"
      },
      "500": {
        "$value": "#eac435",
        "$description": "Fill only — 1.69:1 on white."
      },
      "700": {
        "$value": "#8d710b",
        "$description": "Lowest gold legible as text on white — 4.67:1, AA."
      },
      "900": {
        "$value": "#6b5507"
      }
    },
    "neutral": {
      "$type": "color",
      "$description": "Single grey ramp with a faint green undertone. Replaces the ad-hoc #eef0f1 / #f0f0f0 / #8f8f8f / #6e6e6e greys.",
      "0": {
        "$value": "#ffffff"
      },
      "50": {
        "$value": "#f8faf8"
      },
      "100": {
        "$value": "#f0f3f0"
      },
      "200": {
        "$value": "#e2e7e3"
      },
      "300": {
        "$value": "#c9d1cb"
      },
      "400": {
        "$value": "#a3aea6"
      },
      "500": {
        "$value": "#7d8a80"
      },
      "600": {
        "$value": "#5e6b62"
      },
      "700": {
        "$value": "#46514a"
      },
      "800": {
        "$value": "#303833"
      },
      "900": {
        "$value": "#1a1f1c"
      }
    },
    "status": {
      "$type": "color",
      "success": {
        "$value": "#0e7a4a",
        "$description": "5.38:1 on white."
      },
      "warning": {
        "$value": "#8d710b",
        "$description": "4.67:1 on white."
      },
      "danger": {
        "$value": "#b3242f",
        "$description": "6.54:1 on white. Replaces the retired brand red #da2c38."
      },
      "successBright": {
        "$value": "#6fd39b",
        "$description": "Success on the forest-dark canvas — 6.92:1. The light-context success collapses to 2.35:1 there."
      },
      "warningBright": {
        "$value": "#f4dc7e",
        "$description": "Warning on the forest-dark canvas — 9.28:1."
      },
      "dangerBright": {
        "$value": "#ffb3b3",
        "$description": "Danger on the forest-dark canvas — 7.45:1."
      }
    },
    "retired": {
      "$description": "Removed from the system. Listed so they can be found and eliminated during rollout.",
      "navy": {
        "$value": "#253787",
        "$description": "Dropped — palette sprawl."
      },
      "brandRed": {
        "$value": "#da2c38",
        "$description": "Dropped as a brand colour; danger role now uses status.danger."
      },
      "wixBlue": {
        "$value": "#116dff",
        "$description": "Wix stock link blue leaking into the theme. Eliminate."
      },
      "greyA": {
        "$value": "#eef0f1"
      },
      "greyB": {
        "$value": "#f0f0f0"
      },
      "greyC": {
        "$value": "#8f8f8f"
      },
      "greyD": {
        "$value": "#6e6e6e"
      }
    }
  },
  "semantic": {
    "$description": "The layer components consume. Light values shown; the forest-dark context redefines each of these (see tokens.css .on-dark).",
    "bg": {
      "$value": "{color.neutral.0}"
    },
    "surface": {
      "$value": "{color.neutral.0}"
    },
    "surfaceSunken": {
      "$value": "{color.neutral.50}"
    },
    "surfaceRaised": {
      "$value": "{color.neutral.0}"
    },
    "surfaceAccent": {
      "$value": "{color.green.50}"
    },
    "surfaceInverse": {
      "$value": "{color.green.900}"
    },
    "ink": {
      "$value": "{color.green.900}",
      "$description": "12.67:1 on white."
    },
    "inkMuted": {
      "$value": "{color.neutral.600}",
      "$description": "5.59:1 on white."
    },
    "inkSubtle": {
      "$value": "{color.neutral.500}",
      "$description": "3.61:1 — large text and UI only, never body copy."
    },
    "inkInverse": {
      "$value": "{color.neutral.0}"
    },
    "border": {
      "$value": "{color.neutral.200}"
    },
    "borderStrong": {
      "$value": "{color.neutral.300}"
    },
    "brand": {
      "$value": "{color.green.400}",
      "$description": "Fill role."
    },
    "brandHover": {
      "$value": "{color.green.300}",
      "$description": "The brand fill LIFTS on hover rather than darkening — the label is forest ink, and a darker fill drops the pair to 4.15:1. Lifting holds 7.09:1."
    },
    "brandActive": {
      "$value": "{color.green.200}"
    },
    "onBrand": {
      "$value": "{color.green.900}",
      "$description": "5.65:1 on brand fill. This is the fix for the old white-on-green CTA."
    },
    "brandText": {
      "$value": "{color.green.700}",
      "$description": "Text role — 6.81:1 on white, 6.49:1 on the sunken surface. green-600 was 0.18 short on sunken, so the link colour is one step darker."
    },
    "brandTextHover": {
      "$value": "{color.green.800}"
    },
    "accent": {
      "$value": "{color.gold.500}"
    },
    "onAccent": {
      "$value": "{color.green.900}",
      "$description": "7.51:1 on accent."
    },
    "focus": {
      "$value": "{color.green.600}"
    },
    "cta": {
      "$value": "{color.gold.500}",
      "$description": "Primary CTA fill. Gold is the primary CTA on this brand; the green fill is secondary."
    },
    "ctaHover": {
      "$value": "{color.gold.300}"
    },
    "onCta": {
      "$value": "{color.green.900}",
      "$description": "7.51:1 on gold. White on gold is 1.69:1 — never."
    },
    "surfaceGold": {
      "$value": "{color.gold.500}",
      "$description": "Full-bleed gold section. See the .on-gold context in tokens.css."
    },
    "highlight": {
      "$value": "{color.gold.300}",
      "$description": "Highlighter behind running copy."
    },
    "onHighlight": {
      "$value": "{color.green.900}",
      "$description": "9.28:1."
    }
  },
  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Manrope",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Poppins",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "$description": "Fluid via clamp(); the min/max comments give the mobile and desktop pixel sizes.",
      "display": {
        "$value": "clamp(2.75rem, 1.60rem + 5.00vw, 5.00rem)",
        "$description": "44 → 80"
      },
      "h1": {
        "$value": "clamp(2.25rem, 1.55rem + 3.00vw, 3.75rem)",
        "$description": "36 → 60"
      },
      "h2": {
        "$value": "clamp(1.85rem, 1.40rem + 2.00vw, 2.85rem)",
        "$description": "30 → 46"
      },
      "h3": {
        "$value": "clamp(1.50rem, 1.25rem + 1.10vw, 2.10rem)",
        "$description": "24 → 34"
      },
      "h4": {
        "$value": "clamp(1.25rem, 1.12rem + 0.60vw, 1.60rem)",
        "$description": "20 → 26"
      },
      "h5": {
        "$value": "clamp(1.10rem, 1.03rem + 0.30vw, 1.30rem)",
        "$description": "18 → 21"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "base": {
        "$value": "1rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "xs": {
        "$value": "0.75rem"
      }
    },
    "lineHeight": {
      "display": {
        "$value": 1.02
      },
      "tight": {
        "$value": 1.12
      },
      "snug": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.65
      }
    },
    "tracking": {
      "display": {
        "$value": "-0.035em"
      },
      "tight": {
        "$value": "-0.02em"
      },
      "snug": {
        "$value": "-0.01em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.04em"
      },
      "label": {
        "$value": "0.08em"
      }
    },
    "weight": {
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "4pt base, 8pt rhythm.",
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "0.25rem"
    },
    "2": {
      "$value": "0.5rem"
    },
    "3": {
      "$value": "0.75rem"
    },
    "4": {
      "$value": "1rem"
    },
    "5": {
      "$value": "1.5rem"
    },
    "6": {
      "$value": "2rem"
    },
    "7": {
      "$value": "2.5rem"
    },
    "8": {
      "$value": "3rem"
    },
    "9": {
      "$value": "4rem"
    },
    "10": {
      "$value": "5rem"
    },
    "11": {
      "$value": "6rem"
    },
    "12": {
      "$value": "8rem"
    },
    "section": {
      "sm": {
        "$value": "clamp(2.5rem, 1.5rem + 4vw, 4rem)"
      },
      "md": {
        "$value": "clamp(4rem, 2.5rem + 6vw, 7rem)"
      },
      "lg": {
        "$value": "clamp(5rem, 3rem + 8vw, 10rem)"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Four values, replacing the seven previously in use (4, 6, 8, 16, 40, 300px, 50%).",
    "sm": {
      "$value": "6px",
      "$description": "Inputs, tags, small chips."
    },
    "md": {
      "$value": "10px",
      "$description": "Buttons, small cards, form controls."
    },
    "lg": {
      "$value": "16px",
      "$description": "Cards, media, panels."
    },
    "pill": {
      "$value": "999px",
      "$description": "Chips, avatars, pill buttons."
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Forest-tinted, never pure black. On light surfaces prefer a border to a shadow.",
    "0": {
      "$value": "none"
    },
    "1": {
      "$value": "0 1px 2px rgba(28,56,48,0.06), 0 1px 3px rgba(28,56,48,0.04)"
    },
    "2": {
      "$value": "0 2px 4px rgba(28,56,48,0.06), 0 4px 12px rgba(28,56,48,0.07)"
    },
    "3": {
      "$value": "0 4px 8px rgba(28,56,48,0.07), 0 12px 28px rgba(28,56,48,0.10)"
    },
    "4": {
      "$value": "0 8px 16px rgba(28,56,48,0.08), 0 24px 56px rgba(28,56,48,0.14)"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": "80ms"
      },
      "fast": {
        "$value": "140ms"
      },
      "base": {
        "$value": "220ms"
      },
      "slow": {
        "$value": "360ms"
      },
      "entrance": {
        "$value": "520ms"
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "out": {
        "$value": [
          0.16,
          1,
          0.3,
          1
        ]
      },
      "in": {
        "$value": [
          0.7,
          0,
          0.84,
          0
        ]
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "containerNarrow": {
      "$value": "880px"
    },
    "containerMax": {
      "$value": "1280px"
    },
    "containerWide": {
      "$value": "1440px"
    },
    "gutter": {
      "$value": "clamp(1rem, 0.5rem + 2.5vw, 2.5rem)"
    },
    "measure": {
      "$value": "68ch"
    },
    "measureNarrow": {
      "$value": "52ch"
    }
  }
}
